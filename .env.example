# Server-only Railway variables — never prefix these with EXPO_PUBLIC_.
DATABASE_URL=
DEVICE_TOKEN_PEPPER=
GIFT_TOKEN_PEPPER=
GIFT_AUTH_PEPPER=
RESEND_API_KEY=
GIFT_EMAIL_FROM=support@onetapreality.com
GIFT_ADMIN_EMAILS=developer@onetapreality.com
GIFT_CARD_CLEANUP_SECRET=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Keep empty in active external-Beta staging and production.
# Set a non-empty list only for a separately approved restricted environment.
ALPHA_ALLOWED_EMAILS=
# Set false only while immediately pausing Alpha gift sharing.
GIFT_SHARING_ENABLED=true
# Set true only during an approved production data-migration write freeze.
API_WRITE_FREEZE=false
# Production default is https://onetapreality.com; staging uses https://staging.onetapreality.com.
GIFT_URL_ORIGIN=https://onetapreality.com
# Server deployment audience; production stays public. Review access requires external-beta and staging origin.
RELEASE_AUDIENCE=public
# External-Beta-only App Review credentials. Keep disabled and empty outside the isolated review service.
APPLE_REVIEW_ACCESS_ENABLED=false
APPLE_REVIEW_EMAIL=
APPLE_REVIEW_CODE=
APPLE_REVIEW_FIXTURE_SECRET=
APPLE_REVIEW_CLAIM_TOKEN=
