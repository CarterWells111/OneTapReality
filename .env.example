# Public client origin. Leave empty during Expo development; after Railway deployment,
# set this to the generated HTTPS domain and rebuild the native app.
EXPO_PUBLIC_API_ORIGIN=

# Local PostgreSQL database. Railway replaces this with a reference to its PostgreSQL service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adventurex

# Server-only secret. Never prefix this with EXPO_PUBLIC_ or commit a real value.
DEVICE_TOKEN_PEPPER=replace-with-a-local-only-secret

# Local production-like server only. Railway injects PORT automatically.
PORT=3000
