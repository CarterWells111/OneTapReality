{
  "expo": {
    "name": "OneTapReality",
    "slug": "onetapreality",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/onetapreality-icon.png",
    "scheme": "onetapreality",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.onetapreality.app",
      "associatedDomains": [
        "applinks:onetapreality.com"
      ]
    },
    "android": {
      "package": "com.onetapreality.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "onetapreality.com",
              "pathPrefix": "/gift"
            },
            {
              "scheme": "https",
              "host": "onetapreality.com",
              "pathPrefix": "/activate"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F7F2EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OneTapReality to access your selected photos to create albums."
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F2EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Allow OneTapReality to read and write NFC gift cards.",
          "includeNdefEntitlement": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12831d3a-34cb-49a1-9efa-6bfd26afef7c"
      }
    },
    "owner": "onereality"
  }
}
