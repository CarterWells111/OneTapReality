{
  "expo": {
    "name": "OneTapReality",
    "slug": "onetapreality",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/onetapreality-icon.png",
    "scheme": "onetapreality",
    "locales": {
      "en": "./locales/en.json",
      "zh-Hans": "./locales/zh-Hans.json"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.onereality.onetapreality",
      "associatedDomains": [
        "applinks:onetapreality.com",
        "applinks:staging.onetapreality.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "MinimumOSVersion": "15.1"
      }
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "photosPermission": "Choose specific photos to create or edit a travel album."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Choose specific photos to create or edit a travel album.",
          "savePhotosPermission": "Save an exported travel album to your photo library when you choose to do so."
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F2EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Scan a OneTapReality gift card to open its invitation link.",
          "includeNdefEntitlement": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12831d3a-34cb-49a1-9efa-6bfd26afef7c"
      }
    },
    "owner": "onereality"
  }
}
