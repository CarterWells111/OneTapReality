{
  "cli": {
    "version": ">=16.0.1",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "distribution": "internal",
      "developmentClient": true,
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "development-staging"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "production"
      }
    },
    "alpha": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "alpha-staging"
      }
    },
    "staging-testflight": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging-testflight"
      }
    },
    "beta-external": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "external-beta-staging"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production"
      }
    }
  },
  "submit": {
    "staging-testflight": {
      "ios": {
        "ascAppId": "6794186067",
        "groups": [
          "OneTapReality开发员测试"
        ]
      }
    },
    "beta-external": {
      "ios": {
        "ascAppId": "6794186067"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6794186067"
      }
    }
  }
}
