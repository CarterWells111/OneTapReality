{
  "name": "onetapreality",
  "main": "expo-router/entry",
  "version": "1.1.4",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.8.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.8.2",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@expo/config-plugins": "~57.0.9",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "compression": "^1.8.1",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo": "^57.0.20",
    "expo-asset": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-media-library": "~57.0.4",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-server": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "express": "^5.2.1",
    "morgan": "^1.12.0",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nfc-manager": "4.0.0-beta.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "resend": "^6.26.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "jest-expo": "~57.0.5",
    "pg-mem": "^3.0.14",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "node scripts/run-expo-with-variant.cjs development-staging start",
    "start": "node scripts/run-expo-with-variant.cjs development-staging start",
    "build:server": "node scripts/run-expo-with-variant.cjs production export --platform web --no-ssg",
    "start:server": "node --require dotenv/config server.cjs",
    "verify:backend": "node scripts/verify-backend.cjs",
    "verify:public-site": "node scripts/verify-public-site.cjs",
    "verify:migration": "node scripts/verify-migration.cjs",
    "check:lockfile": "node scripts/check-release-lockfile.cjs",
    "beta:preflight:ios": "node scripts/check-ios-beta-readiness.cjs --profile beta-external",
    "alpha:preflight:ios": "node scripts/check-ios-beta-readiness.cjs --profile alpha",
    "staging:preflight:ios": "node scripts/check-ios-beta-readiness.cjs --profile staging-testflight",
    "development:preflight:ios": "node scripts/check-ios-development-readiness.cjs",
    "release:ios": "node scripts/release-ios-testflight.cjs",
    "reset-project": "node ./scripts/reset-project.js",
    "ios": "node scripts/run-expo-with-variant.cjs development-staging start --ios",
    "web": "node scripts/run-expo-with-variant.cjs development-staging start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch",
    "test:ci": "jest --runInBand && node --test __tests__/app-store-site.test.mjs __tests__/team-coordination-docs.test.mjs __tests__/active-branding-docs.test.mjs",
    "worker:check": "npx --yes wrangler@4.86.0 deploy --dry-run --config workers/gift-maintenance/wrangler.toml --outdir .wrangler-dist",
    "test:backend": "jest --runInBand --runTestsByPath __tests__/backend-validation.test.ts __tests__/backend-auth.test.ts __tests__/backend-migrations.test.ts __tests__/backend-repository.test.ts __tests__/backend-routes.test.ts __tests__/backend-client.test.ts __tests__/backend-db-client.test.ts __tests__/device-credentials.test.ts __tests__/app-config.test.ts __tests__/backend-smoke.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "nfc:test:seed": "node scripts/nfc-staging-test.cjs seed",
    "nfc:test:inspect": "node scripts/nfc-staging-test.cjs inspect",
    "nfc:test:prepare-pr": "node scripts/nfc-staging-test.cjs prepare-pr",
    "nfc:test:guard": "node scripts/nfc-staging-test.cjs guard"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/__tests__"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/.worktrees/",
      "<rootDir>/.claude/worktrees/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.worktrees/",
      "<rootDir>/.claude/worktrees/"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nfc-manager"
        ]
      }
    }
  },
  "overrides": {
    "@expo/plist": {
      "@xmldom/xmldom": "0.8.15"
    },
    "plist": {
      "@xmldom/xmldom": "0.9.12"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "@eslint/eslintrc": {
      "js-yaml": "4.3.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.1"
    },
    "qs": "6.16.0",
    "uuid": "11.1.1"
  },
  "private": true
}
