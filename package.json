{
  "name": "onetapreality",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "engines": {
    "node": ">=20.19.4",
    "npm": ">=10.8.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=20.19.4",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.8.2",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "compression": "^1.8.1",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-media-library": "~18.2.1",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-server": "~1.0.7",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "express": "^5.2.1",
    "morgan": "^1.11.0",
    "pg": "^8.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nfc-manager": "4.0.0-beta.6",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "resend": "^6.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.1.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "jest-expo": "~54.0.17",
    "pg-mem": "^3.0.14",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "build:server": "expo export --platform web --no-ssg",
    "start:server": "node --require dotenv/config server.cjs",
    "verify:backend": "node scripts/verify-backend.cjs",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch",
    "test:ci": "jest --runInBand && node --test __tests__/app-store-site.test.mjs __tests__/team-coordination-docs.test.mjs __tests__/active-branding-docs.test.mjs",
    "worker:check": "npx --yes wrangler@4.86.0 deploy --dry-run --config workers/gift-maintenance/wrangler.toml --outdir .wrangler-dist",
    "test:backend": "jest --runInBand --runTestsByPath __tests__/backend-validation.test.ts __tests__/backend-auth.test.ts __tests__/backend-migrations.test.ts __tests__/backend-repository.test.ts __tests__/backend-routes.test.ts __tests__/backend-client.test.ts __tests__/backend-db-client.test.ts __tests__/device-credentials.test.ts __tests__/backend-screen.test.tsx __tests__/app-config.test.ts __tests__/backend-smoke.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/.worktrees/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.worktrees/"
    ]
  },
  "private": true
}
